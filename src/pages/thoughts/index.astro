---
import Base from '../../layouts/Base.astro';
import Stream from '../../components/Stream.astro';
import { getThoughts, getStream, slugify } from '../../lib/posts';

const posts = await getStream(['thought']);
const counts = new Map<string, number>();
for (const n of await getThoughts()) for (const t of n.data.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
const tags = [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---
<Base title="Thoughts" description="Shorter pieces: radio builds, homelab, books and things learned along the way.">
  <p class="kicker">Thoughts</p>
  <h1 class="page-title">Thoughts</h1>
  <p class="lede">Shorter and rougher than the essays: radio builds, homelab, book commentary and things learned along the way.</p>
  {tags.length > 0 && (
    <ul class="tags" style="margin: 0 0 12px" aria-label="Browse by tag">
      {tags.map(([t, n]) => <li><a href={`/thoughts/tags/${slugify(t)}/`}>{t} ({n})</a></li>)}
    </ul>
  )}
  <Stream posts={posts} searchLabel="Search thoughts and essays" empty="Nothing here yet." />
</Base>

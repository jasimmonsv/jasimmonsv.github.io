---
import Base from '../layouts/Base.astro';
import books from '../data/library.json';

type Book = { title: string; author: string; status: 'reading' | 'shelf' | 'want' | 'reference'; year?: number; note?: string; tags?: string[] };
const all = books as Book[];

const groups: { key: Book['status']; label: string; blurb: string }[] = [
  { key: 'reading', label: 'Reading now', blurb: 'On the nightstand or in the earbuds.' },
  { key: 'reference', label: 'Reference shelf', blurb: 'Books I return to.' },
  { key: 'shelf', label: 'The antilibrary', blurb: 'Owned, mostly unread, deliberately.' },
  { key: 'want', label: 'Wishlist', blurb: 'Knowledge I want next.' },
];
---
<Base title="Library" description="The antilibrary of J.A. Simmons V: books owned, read, referenced and wanted.">
  <article data-pagefind-body>
    <p class="kicker" data-pagefind-meta="kind">Library</p>
    <h1 class="page-title" data-pagefind-meta="title">The antilibrary</h1>
    <p class="lede">A library is not a collection of books you have read, but a collection of knowledge you want, whether for reference or for life goals. A library is never a trophy room.</p>
    <div class="prose">
      <p>I have always loved books: the feel, the ideal, the smell. My philosophy on them is simple:</p>
      <ol>
        <li>Never lend a book. If you lend a book to somebody, expect never to get it back. #SaveAFriendship</li>
        <li>Keep the books for the knowledge you want, not the ones you've finished.</li>
      </ol>
      <p>More in <a href="/thoughts/my-philosophy-on-books/">my philosophy on books</a>. Recommendations are welcome on <a href="https://hachyderm.io/@jasimmonsv">Mastodon</a>. This list is the canonical one; I also track reading on <a href="https://hardcover.app/@jasimmonsv">Hardcover</a> and <a href="https://www.goodreads.com/user/show/2784493-j-a">Goodreads</a>.</p>
    </div>

    {all.length === 0 && <p class="empty">The catalogue is being moved over from Goodreads.</p>}
    {groups.map((g) => {
      const items = all.filter((b) => b.status === g.key);
      return items.length > 0 && (
        <section>
          <h2 class="year" style="margin-top: 32px">{g.label}</h2>
          <p class="results-note" style="margin-top: 6px">{g.blurb}</p>
          <div class="cards">
            {items.map((b) => (
              <div class="card">
                <h3>{b.title}</h3>
                <p>{b.author}{b.year ? `, ${b.year}` : ''}</p>
                {b.note && <p class="sub">{b.note}</p>}
              </div>
            ))}
          </div>
        </section>
      );
    })}
  </article>
</Base>

---
import { render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { getEssays, readingMinutes } from '../../lib/posts';

export async function getStaticPaths() {
  const essays = await getEssays();
  return essays.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Article kind="Essay" title={entry.data.title} summary={entry.data.summary} date={entry.data.date} updated={entry.data.updated} minutes={readingMinutes(entry.body)} tags={entry.data.tags}>
  <Content />
</Article>

---
import Base from '../layouts/Base.astro';
import Stream from '../components/Stream.astro';
import { getStream } from '../lib/posts';

const posts = await getStream();
---
<Base>
  <h1 class="visually-hidden">Essays and thoughts</h1>
  <Stream posts={posts} filters empty="The first essays are on the way. Follow along with the RSS feed." />
</Base>

---
// The Bookmark mark: an oxblood ribbon with the V cut out.
// `cut` is the colour showing through the V (the surface behind the mark).
interface Props { cut?: string; size?: number; title?: string }
const { cut = 'var(--panel)', size, title } = Astro.props;
---
<svg viewBox="0 0 64 64" width={size} height={size} role={title ? 'img' : undefined} aria-hidden={title ? undefined : 'true'} aria-label={title}>
  <path d="M16 4H48V60L32 46L16 60Z" fill="#9b1c1c" />
  <path d="M21 13H28L32 27L36 13H43L35 36H29Z" fill={cut} />
</svg>
